# Herdr runtime state and files Herdr rewrites on start
personal/herdr-app/shared.json
personal/herdr-app/view.json
personal/herdr-app/window.json
personal/herdr-app/seen.json
personal/herdr-app/installed.json
# Generated files
*.d.ts
jsconfig.json
# Only skillshare/skills/mine/ is committed. Every other top-level folder there (a skill Skillshare
# installed, synced/) stays out of the repo; installed skills are recorded in .metadata.json.
skillshare/skills/*/
!skillshare/skills/mine/
.sync-backup/
